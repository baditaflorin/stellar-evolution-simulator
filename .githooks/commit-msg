#!/usr/bin/env sh
set -eu

message_file="$1"
first_line="$(head -n 1 "$message_file")"

if printf "%s" "$first_line" | grep -Eq '^(feat|fix|docs|chore|refactor|test|ops|data|security|perf|style|build)(\([a-z0-9._-]+\))?: .+'; then
  exit 0
fi

echo "Commit message must use Conventional Commits."
echo "Example: feat: add stellar track chart"
exit 1
